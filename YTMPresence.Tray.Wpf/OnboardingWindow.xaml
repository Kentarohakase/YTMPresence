<Window x:Class="YTMPresence.TrayWpf.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tw="clr-namespace:YTMPresence.TrayWpf"
        Title="{x:Static tw:UiText.OnboardingWindowTitle}"
        Width="620" Height="740" MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{x:Static tw:UiText.OnboardingHeading}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Margin="0,4,0,8" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static tw:UiText.OnboardingIntro}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <GroupBox Header="{x:Static tw:UiText.OnboardingStepInstall}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{x:Static tw:UiText.OnboardingInstallHint}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{x:Static tw:UiText.OnboardingStoreButton}" Padding="12,6" Margin="0,0,8,6" Click="OpenStoreButton_Click" />
                            <Button Content="{x:Static tw:UiText.OnboardingFirefoxButton}" Padding="12,6" Margin="0,0,0,6" Click="OpenFirefoxButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="{x:Static tw:UiText.OnboardingStepToken}" Padding="12" Margin="0,0,0,10">
                    <DockPanel>
                        <Button Content="{x:Static tw:UiText.OnboardingCopyTokenButton}" Padding="12,6" Margin="8,0,0,0" DockPanel.Dock="Right" Click="CopyTokenButton_Click" />
                        <TextBox x:Name="SecurityTokenBox" IsReadOnly="True" FontFamily="Consolas" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{x:Static tw:UiText.LabelSecurityToken}" />
                    </DockPanel>
                </GroupBox>
                <GroupBox Header="{x:Static tw:UiText.OnboardingStepCheck}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{x:Static tw:UiText.OnboardingCheckHint}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static tw:UiText.OnboardingScopeHint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <Expander Header="{x:Static tw:UiText.OnboardingAdvanced}" Margin="0,12,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{x:Static tw:UiText.OnboardingUrlHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <DockPanel>
                                    <Button Content="{x:Static tw:UiText.ButtonCopy}" Padding="12,6" Margin="8,0,0,0" DockPanel.Dock="Right"
                                            AutomationProperties.Name="{x:Static tw:UiText.OnboardingCopyUrlButton}" Click="CopyUrlButton_Click" />
                                    <TextBox x:Name="CompanionUrlBox" IsReadOnly="True" FontFamily="Consolas" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="{x:Static tw:UiText.LabelCompanionUrl}" />
                                </DockPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="{x:Static tw:UiText.OnboardingStepMusic}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{x:Static tw:UiText.OnboardingMusicHint}" TextWrapping="Wrap" />
                        <Button Content="{x:Static tw:UiText.ButtonYouTubeMusic}" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0" Click="OpenYtmButton_Click" />
                    </StackPanel>
                </GroupBox>
                <Expander Header="{x:Static tw:UiText.OnboardingDeveloper}" Margin="0,0,0,12">
                    <TextBlock Text="{x:Static tw:UiText.OnboardingInstructions}" TextWrapping="Wrap" Margin="12,8" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Margin="0,10,0,10"
                   AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="{x:Static tw:UiText.ButtonSettingsShort}" Padding="12,6" Margin="0,0,8,0" Click="OpenSettingsButton_Click" />
            <Button Content="{x:Static tw:UiText.ButtonDone}" Padding="12,6" Margin="0,0,8,0" Click="DoneButton_Click" />
            <Button Content="{x:Static tw:UiText.ButtonLater}" Padding="12,6" IsCancel="True" Click="LaterButton_Click" />
        </WrapPanel>
    </Grid>
</Window>
